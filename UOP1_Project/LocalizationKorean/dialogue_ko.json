{
 "items": [
  {
   "id": 58354979076694141,
   "ko": "그래서 그게 뭐였어요?"
  },
  {
   "id": 58354979076694142,
   "ko": "후추예요, 친구!"
  },
  {
   "id": 58354979076694144,
   "ko": "아쉽게도 드릴 게 없어요. 제 레시피에 쓸 것도요."
  },
  {
   "id": 58354979076694116,
   "ko": "이 음식 축제가 이곳에서 아주 중요한 행사인 것 같네요."
  },
  {
   "id": 58354979076694138,
   "ko": "뭘 추천해 주실 수 있나요?"
  },
  {
   "id": 58354979076694136,
   "ko": "대회에 참가할까 생각 중이에요."
  },
  {
   "id": 58354979076694127,
   "ko": "먹을 기회가 있을 때마다"
  },
  {
   "id": 58354979076694167,
   "ko": "예"
  },
  {
   "id": 58354979076694166,
   "ko": "내가 평생 그로엔 씨앗으로 요리해 왔다는 건 알겠지? 뭔가 새로운 걸 가져왔나?"
  },
  {
   "id": 58354979076694125,
   "ko": "\"물, 밀가루, 설탕, 이스트"
  },
  {
   "id": 58354979076694124,
   "ko": "당신이 흥미를 느낄 사람도 만날지 몰라요. 노래 한 곡 들어 볼래요?"
  },
  {
   "id": 58354979076694145,
   "ko": "이러면 좋겠는데, 좀 구해다 줄 수 있어요? 지금은 가게를 비울 수 없어서요."
  },
  {
   "id": 58354979076694117,
   "ko": "네, 그게 트러플턴의 전부예요! 기다리는 동안 제가 구경시켜 줄게요!"
  },
  {
   "id": 58354979076694119,
   "ko": "저 바위 사이 좁은 길은 산으로 이어져요. 조금 위험하고, 그다지 재미있진 않아요."
  },
  {
   "id": 58354979076694139,
   "ko": "오! 젊은 요리사가 제 길을 찾도록 돕는 건 언제나 기쁜 일이지."
  },
  {
   "id": 58354979076694137,
   "ko": "그리고 우승에 도움이 될 만한 걸 찾고 있어요."
  },
  {
   "id": 58354979076694143,
   "ko": "답은 언제나 후추예요!"
  },
  {
   "id": 45599299228000256,
   "ko": "예시입니다"
  },
  {
   "id": 45599303694934016,
   "ko": "예시입니다"
  },
  {
   "id": 45599308925231104,
   "ko": "예시입니다"
  },
  {
   "id": 45602155272200192,
   "ko": "테스트"
  },
  {
   "id": 45602159407783936,
   "ko": "확인"
  },
  {
   "id": 45602163023273984,
   "ko": "우우"
  },
  {
   "id": 45667467006959616,
   "ko": "테스트"
  },
  {
   "id": 45668460641771520,
   "ko": "아니오"
  },
  {
   "id": 58354979076694111,
   "ko": "그러고 보니, 레시피를 알려줄게요."
  },
  {
   "id": 58354979076694134,
   "ko": "특별히 찾는 게 있나요?"
  },
  {
   "id": 58354979076694133,
   "ko": "안녕하세요! 저는 펠펠이에요. 제 가게에 잘 오셨어요!"
  },
  {
   "id": 58354979076694132,
   "ko": "이제 축제를 둘러보세요. 필요하면 여기 있을게요."
  },
  {
   "id": 58354979076694131,
   "ko": "디저트는 제 전문이 아니에요. 그 사람은 나중에 만나 보고 싶네요."
  },
  {
   "id": 47020049298219008,
   "ko": "냄비를 찾아서 요리는 만들어 봤나요?"
  },
  {
   "id": 47020057464528896,
   "ko": "훌륭해요! 이제 진짜 요리사네요!"
  },
  {
   "id": 47020061562363904,
   "ko": "아직 요리가 없군요. 만들고 나서 다시 오세요."
  },
  {
   "id": 58354979076694129,
   "ko": "그녀는 나무 사이에서 자주 보이지"
  },
  {
   "id": 58354979076694128,
   "ko": "마무리는 달콤한 것으로 하고 싶겠지"
  },
  {
   "id": 58354979076694110,
   "ko": "오, 잘됐네요! 덕분에 살았어요! 주방을 준비해 둘게요."
  },
  {
   "id": 58354979076694123,
   "ko": "재미있는 재료가 가득한 곳이겠네요."
  },
  {
   "id": 58354979076694164,
   "ko": "흠. 새롭고 멋진 레시피를 하나 알려줄 수 있지…… 락캔디를 쓰는 걸로."
  },
  {
   "id": 58354979076694122,
   "ko": "하지만 위로 가지 않고 강을 건너 마을 밖으로 나가면 근처 숲에 이르게 돼요."
  },
  {
   "id": 58354979076694165,
   "ko": "그로엔 씨앗의 단맛을 새롭게 즐기는 법도 알려주지."
  },
  {
   "id": 58354979076694162,
   "ko": "네, 그리고 친구를 돕는 것도요."
  },
  {
   "id": 58354979076694163,
   "ko": "시간을 좀 내줄 수 있어요. 후추 열매도 가지고 있고요. 그럼 저는 뭘 얻나요?"
  },
  {
   "id": 58354979076694161,
   "ko": "하! 맛을 더하고 싶은 건가요?"
  },
  {
   "id": 58354979076694158,
   "ko": "새로운 단맛을 찾아보려고요."
  },
  {
   "id": 58354979076694160,
   "ko": "후추 열매를 찾으러 왔어요. 어디서 구할 수 있는지 아세요?"
  },
  {
   "id": 58354979076694159,
   "ko": "당신은요? 마을 밖에서 뭘 하고 있어요?"
  },
  {
   "id": 58354979076694157,
   "ko": "아직 레시피를 완성하지 못했어요!"
  },
  {
   "id": 58354979076694156,
   "ko": "물론 비밀 레시피가 아니라면요!"
  },
  {
   "id": 58354979076694155,
   "ko": "그럼 대회용이 아니라면, 거기서 뭘 만들고 있는 거예요?"
  },
  {
   "id": 58354979076694154,
   "ko": "우리 운이 좋네요!"
  },
  {
   "id": 58354979076694153,
   "ko": "아니요, 다른 사람들에게 불공평하잖아요."
  },
  {
   "id": 58354979076694151,
   "ko": "이 근처에 다른 사람이 있는 줄 몰랐어요. 하필 오늘이라니!"
  },
  {
   "id": 58354979076694152,
   "ko": "안녕하세요! 저도 여기서 만나서 놀랐어요. 대회에 참가하지 않으세요?"
  },
  {
   "id": 58354979076694150,
   "ko": "앗! 놀랐잖아요!"
  },
  {
   "id": 58354979076694149,
   "ko": "알고 싶다면 숲에서 후추 알을 좀 가져와요. 그러면 알려줄게요."
  },
  {
   "id": 58354979076694148,
   "ko": "<i>웃음</i>"
  },
  {
   "id": 58354979076694147,
   "ko": "맞혀 볼까요, 냄비에 넣고 2분 저으면 되나요?"
  },
  {
   "id": 58354979076694126,
   "ko": "그녀의 달콤한 빵은 어느 잔치에서나 빛나지"
  },
  {
   "id": 49977052052185088,
   "ko": "달콤한 케이크는 준비됐나요?"
  },
  {
   "id": 49977394600992768,
   "ko": "정말 맛있어요!"
  },
  {
   "id": 49977399298613248,
   "ko": "좋아요, 준비되면 다시 오세요."
  },
  {
   "id": 49978184401018880,
   "ko": "짭짤한 케이크는 준비됐나요?"
  },
  {
   "id": 49978187022458880,
   "ko": "흠…… 고마워요"
  },
  {
   "id": 49978189513875456,
   "ko": "좋아요, 준비되면 다시 오세요."
  },
  {
   "id": 50270895276417024,
   "ko": "보여줄 달콤한 요리는 준비됐나요?"
  },
  {
   "id": 50270899990814720,
   "ko": "정말 맛있어요! 당신이 우승이에요!"
  },
  {
   "id": 50270902855524352,
   "ko": "아, 그렇군요! 그럼 나중에 다시 오세요!"
  },
  {
   "id": 50270915195166720,
   "ko": "보여줄 짭짤한 요리는 준비됐나요?"
  },
  {
   "id": 50270917715943424,
   "ko": "맛은 좋은데, 저는 새로운 걸 원했어요"
  },
  {
   "id": 50270920249303040,
   "ko": "좋아요, 나중에 다시 오세요"
  },
  {
   "id": 58354979076694146,
   "ko": "그래 준다면 제 비밀 레시피를 알려줄게요!"
  },
  {
   "id": 51002952604573696,
   "ko": "천만에요"
  },
  {
   "id": 58354979076694140,
   "ko": "아쉽게도 제일 좋은 물건은 오늘 아침 일찍 다 팔렸어요."
  },
  {
   "id": 58354979076694135,
   "ko": "안녕하세요 펠펠, 채소가 아주 싱싱해 보여요!"
  },
  {
   "id": 53161173213634560,
   "ko": "천만에요"
  },
  {
   "id": 53164289984159744,
   "ko": "아 맞다, 도와줘서 고마워요!"
  },
  {
   "id": 53164918227984384,
   "ko": "고마워요!"
  },
  {
   "id": 53167651165167616,
   "ko": "고마워요"
  },
  {
   "id": 58354979076694130,
   "ko": "잊었다면, 이름은 세리즈\""
  },
  {
   "id": 58354979076694120,
   "ko": "강 옆 길을 따라가면 폭포 아래에 있는 방앗간에 갈 수 있어요."
  },
  {
   "id": 58354979076694121,
   "ko": "그리고 거기서 경사를 올라가면 윗마을이에요. 몇몇 사람이 살고, 전설의 주민 요리사 콤도 거기 있어요."
  },
  {
   "id": 58354979076694109,
   "ko": "아니오"
  },
  {
   "id": 58354979076694112,
   "ko": "고마워요, 저는 늘 새로운 맛을 찾고 싶어요."
  },
  {
   "id": 58354979076694113,
   "ko": "괜찮아요, 천천히 하세요."
  },
  {
   "id": 58354979076694114,
   "ko": "햄릿! 드디어 왔네요!"
  },
  {
   "id": 58354979076694115,
   "ko": "축제가 막 시작됐어요."
  },
  {
   "id": 58354979076694118,
   "ko": "여기가 트러플턴 중앙 광장이에요. 오늘 요리와 먹거리는 대부분 여기서 펼쳐져요."
  },
  {
   "id": 58354979076694101,
   "ko": "고마워요. 음식 축제엔 안 가세요?"
  },
  {
   "id": 58354979076694100,
   "ko": "네, 맞아요."
  },
  {
   "id": 58354979076694099,
   "ko": "여기가 마을 정문인가요?"
  },
  {
   "id": 58354979076694098,
   "ko": "안녕 햄릿, 저는 테라예요."
  },
  {
   "id": 58354979076694104,
   "ko": "도와드릴까요?"
  },
  {
   "id": 58354979076694105,
   "ko": "그래 준다면 정말 천사예요! 클리퍼 알 하나만 있으면 되는데……"
  },
  {
   "id": 58354979076694103,
   "ko": "아침 내내 여기 있는 동굴에 들어가려고 했는데, 꽤 위험해요."
  },
  {
   "id": 58354979076694102,
   "ko": "갈 거예요. 그런데 먼저 특별한 케이크 반죽에 쓸 클리퍼 알을 구해야 해요."
  },
  {
   "id": 58354979076694203,
   "ko": "여러분, 햄릿입니다!"
  },
  {
   "id": 58354979076694202,
   "ko": "햄…… 햄릿."
  },
  {
   "id": 58354979076694107,
   "ko": "어머, 빠르네요. 알은 찾았어요?"
  },
  {
   "id": 58354979076694201,
   "ko": "이름이 뭐라고 했지?"
  },
  {
   "id": 58354979076694200,
   "ko": "트러플턴 주민들이여! 올해 우리 가운데 진짜 재능이 있군."
  },
  {
   "id": 58354979076694199,
   "ko": "…… 걸작이군."
  },
  {
   "id": 58354979076694198,
   "ko": "흠. 이 요리는 진정한……"
  },
  {
   "id": 58354979076694197,
   "ko": "한 입 더 먹어 보지……"
  },
  {
   "id": 58354979076694196,
   "ko": "말해야겠군……"
  },
  {
   "id": 58354979076694195,
   "ko": "나를 감탄시키는 게 쉽지 않다는 건 알 텐데."
  },
  {
   "id": 58354979076694194,
   "ko": "어디에 있어요?"
  },
  {
   "id": 58354979076694193,
   "ko": "한번 먹어 볼까요."
  },
  {
   "id": 58354979076694192,
   "ko": "달콤한 별미"
  },
  {
   "id": 58354979076694191,
   "ko": "매콤한 맛"
  },
  {
   "id": 58354979076694190,
   "ko": "그래서 자기 작품으로 나를 감탄시키고 싶다는 건가?"
  },
  {
   "id": 58354979076694187,
   "ko": "흐음. 트러플턴에 낯선 얼굴이군……"
  },
  {
   "id": 58354979076694186,
   "ko": "오! 좋은 생각이에요! 도와줘서 고마워요, 마캄!"
  },
  {
   "id": 58354979076694185,
   "ko": "가장 좋은 방법은 어울린다고 느껴지는 것들을 섞어 보는 거예요."
  },
  {
   "id": 58354979076694184,
   "ko": "음, 하루 종일 새로운 요리를 찾아다녔어요. 그런데 뭘 내야 할지 모르겠어요."
  },
  {
   "id": 58354979076694183,
   "ko": "대회 준비는 됐어요?"
  },
  {
   "id": 58354979076694182,
   "ko": "또 만났네요!"
  },
  {
   "id": 58354979076694181,
   "ko": "괜찮아요, 대회가 끝나기까진 아직 시간이 있어요."
  },
  {
   "id": 58354979076694180,
   "ko": "방법을 보여줄 수도 있지. 아니, 더 좋은 게 있군. 여기 적어 둔 설명서를 받아 가게."
  },
  {
   "id": 58354979076694108,
   "ko": "예"
  },
  {
   "id": 58354979076694178,
   "ko": "후추는 좀 구했어요?"
  },
  {
   "id": 58354979076694177,
   "ko": "한참 안 보이던데요. 다시 볼 줄은 몰랐어요."
  },
  {
   "id": 58354979076694176,
   "ko": "아니오"
  },
  {
   "id": 58354979076694175,
   "ko": "예"
  },
  {
   "id": 58354979076694174,
   "ko": "다시 왔네요, 친구!"
  },
  {
   "id": 58354979076694173,
   "ko": "그럴 줄 알았지. 창작의 기술을 익히는 데는 시간이 걸리는 법이야."
  },
  {
   "id": 58354979076694172,
   "ko": "약속은 약속이죠. 여기 후추 열매를 드릴게요!"
  },
  {
   "id": 58354979076694171,
   "ko": "해 보고 싶겠지! 산으로 가야 하네. 거기서만 클리퍼가 황금 알을 낳으니까."
  },
  {
   "id": 58354979076694170,
   "ko": "황금 클리퍼 알을 찾았던 때가 생각나는군. 그걸로 은은하고 자연스러운 단맛의 페이스트리를 만들 수 있지!"
  },
  {
   "id": 58354979076694169,
   "ko": "흐음…… 몇 년 만에 맛본 최고의 요리인데?!"
  },
  {
   "id": 58354979076694168,
   "ko": "아니오"
  },
  {
   "id": 58354979076694029,
   "ko": "자고 있던 게 아니야, 나르. 잠깐 눈을 감고 있었을 뿐이야."
  },
  {
   "id": 58354979076694028,
   "ko": "어, 무슨 일이지? 아, 맞다. 거의 다 왔어!"
  },
  {
   "id": 58354979076694027,
   "ko": "<i>짹!</i>"
  },
  {
   "id": 58354979076694026,
   "ko": "축제엔 관심 없나요?"
  },
  {
   "id": 58354979076694025,
   "ko": "저 동굴은 너무 위험해요……"
  },
  {
   "id": 58354979076694024,
   "ko": "미안해요, 친구. 지금은 얘기할 틈이 없네요. 작물이 저절로 거둬지진 않으니까요!"
  },
  {
   "id": 58354979076694023,
   "ko": "축제는 즐거운가? 해마다 우리의 자랑거리지."
  },
  {
   "id": 58354979076694022,
   "ko": "지금은 얘기 못 해요. 후추 생각 중이라서요."
  },
  {
   "id": 58354979076694021,
   "ko": "축제 즐기세요! 저 위에 계신 전설의 요리사에게 요리를 보여주고 운을 시험해 보는 것도 잊지 마세요."
  },
  {
   "id": 58354979076694020,
   "ko": "거기서 만나요!"
  },
  {
   "id": 58354979076694019,
   "ko": "아직 여기 있어요? 축제는 벌써 시작됐어요. 서둘러 마을로 가지 않으면 본 행사를 놓칠 거예요."
  },
  {
   "id": 58354979076694018,
   "ko": "예"
  },
  {
   "id": 58354979076694017,
   "ko": "아니오"
  },
  {
   "id": 58354979076694016,
   "ko": "천만에요!"
  },
  {
   "id": 58354979009585152,
   "ko": "고마워요!"
  },
  {
   "id": 58354979076694084,
   "ko": "그래야 할지도 모르겠네요."
  },
  {
   "id": 58354979076694083,
   "ko": "그분이 대회 심사위원이에요. 만나고 싶다면 대회에 참가하는 게 가장 좋은 방법이죠."
  },
  {
   "id": 58354979076694082,
   "ko": "아직 만나 보지도 못했어요. 그래도 흥미로운 사람 같네요."
  },
  {
   "id": 58354979076694081,
   "ko": "혹시 콤 요리사가 무서워서요? 정말 무섭게 생겼죠."
  },
  {
   "id": 58354979076694080,
   "ko": "딱히 그렇진 않아요. 그런데 그렇게 묻는 사람이 처음은 아니네요."
  },
  {
   "id": 58354979076694079,
   "ko": "아, 대회 때문에 오셨어요?"
  },
  {
   "id": 58354979076694078,
   "ko": "안녕하세요. 네, 요리 축제를 보러 이 섬에 왔어요."
  },
  {
   "id": 58354979076694077,
   "ko": "안녕하세요, 친구! 여기 처음이신가요?"
  },
  {
   "id": 58354979076694076,
   "ko": "그건 그렇고, 먼저 가세요. 저는 잠시 뒤에 따라갈게요. 마을에서 봐요!"
  },
  {
   "id": 58354979076694075,
   "ko": "대회에 써 볼 수도 있겠네요."
  },
  {
   "id": 58354979076694074,
   "ko": "이건 제 요리책에 적어 둘게요!"
  },
  {
   "id": 58354979076694073,
   "ko": "보세요, 나르의 엄청난 온도의 재채기가 크림을 돌처럼 단단한 사탕으로 만들어 버렸어요."
  },
  {
   "id": 58354979076694072,
   "ko": "정말 망친 걸까요? 요리는 때로 가장 뜻밖의 방식으로 완성되기도 해요."
  },
  {
   "id": 58354979076694071,
   "ko": "어어, 작은 친구가 크림에 불 재채기를 해서 다 망쳤네요."
  },
  {
   "id": 58354979076694070,
   "ko": "에구, 나르!"
  },
  {
   "id": 58354979076694069,
   "ko": "<i>불 재채기</i>"
  },
  {
   "id": 58354979076694068,
   "ko": "자, 축제를 보러 가고 싶다면 언덕을 올라가서 지나가면 돼요……"
  },
  {
   "id": 58354979076694067,
   "ko": "와, 요리에 정말 타고났네요! 우리 할머니 솜씨 그대로예요."
  },
  {
   "id": 58354979076694066,
   "ko": "아직 배가 안 고파요? 먹어 보면 알려줘요."
  },
  {
   "id": 58354979076694065,
   "ko": "좋아요! 어떻게 됐어요?"
  },
  {
   "id": 58354979076694064,
   "ko": "아니오"
  },
  {
   "id": 58354979076694063,
   "ko": "예"
  },
  {
   "id": 58354979076694060,
   "ko": "여기 있는 가마솥으로 직접 만들어 봐요. 물은 이미 뜨거울 거예요."
  },
  {
   "id": 58354979076694059,
   "ko": "대대로 우리 가족의 보물이었어요."
  },
  {
   "id": 58354979076694058,
   "ko": "그렇군요. 할머니의 오래된 레시피죠?"
  },
  {
   "id": 58354979076694057,
   "ko": "간단해요. 끓는 물에 그로엔 씨앗 3개를 넣고 2분 저으면 돼요."
  },
  {
   "id": 58354979076694056,
   "ko": "놀랐어요? 원한다면 레시피를 알려줄 수 있어요."
  },
  {
   "id": 58354979076694055,
   "ko": "당신도 요리를 해요?"
  },
  {
   "id": 58354979076694052,
   "ko": "아니오"
  },
  {
   "id": 58354979076694051,
   "ko": "예"
  },
  {
   "id": 58354979076694050,
   "ko": "언덕 위 그로엔에게서 씨앗을 모아 왔나요?"
  },
  {
   "id": 58354979076694049,
   "ko": "당신을 위해서라면 뭐든지요, 친구."
  },
  {
   "id": 58354979076694048,
   "ko": "해변 위 언덕만 넘으면 몇 마리 있어요."
  },
  {
   "id": 58354979076694047,
   "ko": "어디서 찾을 수 있어요?"
  },
  {
   "id": 58354979076694045,
   "ko": "그것들도 좋은 음식을 좋아하는 모양이네요."
  },
  {
   "id": 58354979076694085,
   "ko": "콤 씨 이웃의 삼촌의 여동생한테 들었는데, 올해는 짭짤한 요리를 만드는 게 확실히 감탄시키는 방법이라던데요."
  },
  {
   "id": 58354979076694044,
   "ko": "사람들은 그것들을 그로엔이라고 불러요. 벌레보다 훨씬 많은 걸 먹는 식충식물이죠."
  },
  {
   "id": 58354979076694034,
   "ko": "한참 만이네요! 요리 축제 때문에 왔어요?"
  },
  {
   "id": 58354979076694033,
   "ko": "도착했군요! 요크 섬에 잘 오셨어요!"
  },
  {
   "id": 58354979076694032,
   "ko": "안녕, 햄릿!"
  },
  {
   "id": 58354979076694031,
   "ko": "바다를 싫어하는 건 알지만, 곧 요크에 도착하면 날개를 펼 수 있을 거야."
  },
  {
   "id": 58354979076694030,
   "ko": "<i>짹!</i>"
  },
  {
   "id": 58354979076694097,
   "ko": "안녕하세요, 저는 햄릿이에요. 여기 처음이에요."
  },
  {
   "id": 58354979076694096,
   "ko": "그 괴물들이 수확물을 망치는 동안 수다나 떨 순 없죠!"
  },
  {
   "id": 58354979076694095,
   "ko": "그거 알아요? 그건 가지세요, 선물이에요. 단단한 알을 깨는 데 아주 좋은 도구예요."
  },
  {
   "id": 58354979076694094,
   "ko": "이게 뭐예요? 오, 제 망치를 찾았네요. 그 슬라임들은 음식이든 아니든 뭐든 삼켜 버려요."
  },
  {
   "id": 58354979076694093,
   "ko": "고마워요! 가볍게 다니는 편이라 도구를 많이 안 가져왔거든요."
  },
  {
   "id": 58354979076694092,
   "ko": "아니오"
  },
  {
   "id": 58354979076694091,
   "ko": "예"
  },
  {
   "id": 58354979076694090,
   "ko": "글루코스들을 다 처리했어요?!"
  },
  {
   "id": 58354979076694089,
   "ko": "때맞춰 잘 왔나 보네요. 이 지팡이는 걷는 데만 쓰는 게 아니라고요!"
  },
  {
   "id": 58354979076694088,
   "ko": "올해는 글루코스가 창궐했어요. 농장을 습격해서 수확물을 망치고 있어요!"
  },
  {
   "id": 58354979076694087,
   "ko": "아, 안 돼. 그 끈적한 괴물들이 또 왔어요!"
  },
  {
   "id": 58354979076694086,
   "ko": "오, 고마워요! 믿을 만한 소식통 같네요."
  },
  {
   "id": 58354979076694106,
   "ko": "기꺼이 하죠. 금방 돌아올게요."
  },
  {
   "id": 58354979076694189,
   "ko": "그리고 이제 당신의 입맛을 감탄시킬지도 모를 것을 준비했어요."
  },
  {
   "id": 58354979076694188,
   "ko": "네, 저는 햄릿이에요. 축제에 대한 좋은 얘기를 듣고 고향에서 요크까지 왔어요."
  },
  {
   "id": 58354979076694062,
   "ko": "제가 알려준 달콤한 크림 레시피는 해 봤어요?"
  },
  {
   "id": 58354979076694061,
   "ko": "괜찮아요, 구하면 다시 오세요."
  },
  {
   "id": 58354979076694054,
   "ko": "그건 우리 할머니의 환상적인 달콤한 크림 레시피의 핵심 재료예요."
  },
  {
   "id": 58354979076694053,
   "ko": "오, 좋아요! 고마워요! 저 그거 정말 좋아해요."
  },
  {
   "id": 58354979076694179,
   "ko": "고마워요! 딱 요리를 시작하려던 참이었어요."
  },
  {
   "id": 58354979076694043,
   "ko": "실은 레시피에 쓸 씨앗을 모으려는데, 이곳 식물들이 좀…… 공격적이에요."
  },
  {
   "id": 58354979076694042,
   "ko": "막 도착했는데 벌써 부탁이에요?"
  },
  {
   "id": 58354979076694041,
   "ko": "잠깐, 가기 전에요. 부탁 하나 해도 될까요?"
  },
  {
   "id": 58354979076694040,
   "ko": "마을에 도착하면 확인해 볼게요. 어느 쪽이에요?"
  },
  {
   "id": 58354979076694039,
   "ko": "꼭 해야 해요! 뭘 만들어 낼지 기대되네요."
  },
  {
   "id": 58354979076694038,
   "ko": "꼭 참가할 생각은 아니었는데, 그래도……"
  },
  {
   "id": 58354979076694037,
   "ko": "대회에서 우승하려면 아주 특별한 걸 준비해야 해요!"
  },
  {
   "id": 58354979076694036,
   "ko": "아 그래요, 이곳에선 전설이죠. 감탄시키기가 아주 어려워요."
  },
  {
   "id": 58354979076694035,
   "ko": "네, 이곳 요리사에 대해 좋은 얘기를 들었어요. 콤이라고 하던가요?"
  },
  {
   "id": 58354979076694046,
   "ko": "당신이라면 해낼 수 있을 거예요!"
  },
  {
   "id": 58354979076694204,
   "ko": "이 맛은 첫 입부터 나를 기쁨으로 채우는군."
  },
  {
   "id": 58354979076694205,
   "ko": "고전적이면서도 현대적이고, 움직이지 않고도 시간을 여행하게 만드는군."
  },
  {
   "id": 58354979076694206,
   "ko": "화가가 캔버스를 쓰듯 접시를 썼군. 우아하고 뜻이 담긴 채로."
  },
  {
   "id": 58354979076694207,
   "ko": "올해 축제 최고의 요리사를 축하합시다. 햄릿!"
  },
  {
   "id": 58354979076694208,
   "ko": "나를 감탄시키는 게 쉽지 않다는 건 알 텐데."
  },
  {
   "id": 58354979076694209,
   "ko": "이 요리는 정말이지……"
  },
  {
   "id": 58354979076694210,
   "ko": "…… 시시하군."
  },
  {
   "id": 58354979076694211,
   "ko": "올해도 누구 하나 제대로 값진 걸 만들어 내지 못했군."
  }
 ]
}