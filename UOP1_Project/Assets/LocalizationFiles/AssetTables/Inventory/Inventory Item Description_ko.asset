  m_TableData:
  - m_Id: 24381302830690304
    m_Localized: "\uCE7C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 35059626239057920
    m_Localized: "\uB78D\uC2A4\uD130 \uC218\uD504\uB294 \uC544\uBC84\uC9C0\uC5D0\uAC8C\uC11C
      \uC544\uB4E4\uC5D0\uAC8C\uB85C \uC804\uD574 \uB0B4\uB824\uC628 \uC624\uB798\uB41C
      \uC9D1\uC548 \uC694\uB9AC\uBC95\uC785\uB2C8\uB2E4. \uAC00\uC7A5 \uBE5B\uAE54
      \uC88B\uC740 \uB78D\uC2A4\uD130\uC758 \uC0B4\uACFC \uAC00\uC7A5 \uC999\uC774
      \uB9CE\uC740 \uB808\uBAAC\uC73C\uB85C \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38479410477654016
    m_Localized: "\uB9DD\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38480203641511936
    m_Localized: "\uB178\uB780 \uB808\uBAAC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38489264286064640
    m_Localized: "\uC774 \uBD89\uACE0 \uC0B4\uC774 \uC624\uB978 \uB78D\uC2A4\uD130\uB294
      \uC12C \uAE30\uC2AD\uC5D0\uC11C \uC798 \uC790\uB77C\uBA70 \uBD80\uB4DC\uB7EC\uC6B4
      \uC0B4\uB85C \uC720\uBA85\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38489896376066048
    m_Localized: "\uC2AC\uB77C\uC784 \uD06C\uB9AC\uD130\uC758 \uC54C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38490832171425792
    m_Localized: "\uC0DD\uAC15\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38492819038396416
    m_Localized: "\uB808\uBAA8\uB124\uC774\uB4DC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 40615197902102528
    m_Localized: "\uC774 \uB78D\uC2A4\uD130 \uC218\uD504\uB294 \uADF8\uC57C\uB9D0\uB85C
      \uC77C\uD488\uC785\uB2C8\uB2E4! \uC740\uC740\uD558\uAC8C \uB2E8 \uB78D\uC2A4\uD130
      \uC0B4\uC5D0 \uAC10\uB3C4\uB294 \uB808\uBAAC \uD5A5\uACFC \uC0DD\uAC15\uC758
      \uC0B0\uB73B\uD55C \uAE30\uC6B4\uC744 \uB204\uAD6C\uB098 \uC88B\uC544\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 40617814095028224
    m_Localized: "\uD558\uC640\uC774\uC548 \uD53C\uC790\uB294 \uC774 \uC12C\uC5D0\uC11C
      \uC544\uC8FC \uD754\uD55C \uC74C\uC2DD\uC785\uB2C8\uB2E4. \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740
      \uB2EC\uCF64\uD558\uBA74\uC11C \uC9ED\uC9E4\uD55C \uB9DB\uACFC \uADF8 \uB458\uC758
      \uC5B4\uC6B0\uB7EC\uC9D0\uC744 \uC88B\uC544\uD569\uB2C8\uB2E4. \uD30C\uC778\uC560\uD50C\uC740
      \uACFC\uC77C\uC774\uB77C \uD53C\uC790\uC5D0 \uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uB294
      \uB9D0\uB3C4 \uC788\uC9C0\uB9CC, \uD1A0\uB9C8\uD1A0\uB3C4 \uACFC\uC77C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 68458788392763392
    m_Localized: "\uBC14\uC704 \uD06C\uB9AC\uD130\uC758 \uC54C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 75339038097006592
